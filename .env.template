# Copy this file to .env and add only rotated, active provider credentials.
# Never commit .env or real key values.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

APP_NAME=ARGUS
APP_VERSION=0.1.0
DEBUG=false

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CONNECTOR_TIMEOUT_S=45
CONNECTOR_MAX_RETRIES=1

ROUTING_CONFIG_PATH=config/routing.yaml

CACHE_ENABLED=true
CACHE_TTL_S=3600
CACHE_MAX_BYTES=262144

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# Auth (opt-in): enable only with JWT_SECRET set and rotated client creds.
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

REPORT_MAX_REPAIR_ROUNDS=1