# Copy this file to .env and add only rotated, active provider credentials.
# Never commit .env or real key values.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Override model defaults if providers retire them
# Mistral Medium 3.5; dated snapshot alternative: mistral-medium-2604
MISTRAL_MODEL=mistral-medium-latest
GEMINI_MODEL=gemini-3.7-flash

APP_NAME=ARGUS
APP_VERSION=0.4.0
DEBUG=false

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CONNECTOR_TIMEOUT_S=45
CONNECTOR_MAX_RETRIES=1

ROUTING_CONFIG_PATH=config/routing.yaml
# static = fixed YAML chains; semantic = infer a profile from the query
ROUTER_STRATEGY=static
# A/B experiments: comma list of strategy:weight (weights normalized).
# Empty = disabled. Applies only when the caller omits model_config.router_strategy.
# Example: ROUTER_AB_SPLIT=semantic:80,static:20
ROUTER_AB_SPLIT=
# Embeddings backend for the semantic router: auto|gemini|openai|none.
# 'auto' prefers Gemini when its key exists. Failures fall back to the
# keyword classifier automatically.
ROUTER_EMBEDDING_PROVIDER=auto
ROUTER_EMBEDDING_MODEL=
# Cosine similarity needed to accept an embedding match (0.0-1.0)
ROUTER_EMBEDDING_THRESHOLD=0.35

CACHE_ENABLED=true
CACHE_TTL_S=3600
CACHE_MAX_BYTES=262144

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
# fixed = INCR buckets per window (allows 2x boundary bursts)
# sliding = exact last-window count (no boundary bursts, slightly more Redis work)
RATE_LIMIT_ALGORITHM=fixed

# Auth (opt-in): enable only with JWT_SECRET set and rotated client creds.
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

REPORT_MAX_REPAIR_ROUNDS=1

# Audio transcription (Sarvam STT). Leave SARVAM_API_KEY empty to disable.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# transcribe|translate|verbatim|translit|codemix
SARVAM_STT_MODE=transcribe
# BCP-47 code or 'unknown' for auto-detect
SARVAM_STT_LANGUAGE=unknown
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_TIMEOUT_S=60
AUDIO_MAX_UPLOAD_BYTES=10485760

# Speech output (Sarvam Bulbul TTS). Leave SARVAM_API_KEY set (shared with STT);
# flip SPEECH_ENABLED to false to stop all TTS credit spend.
SPEECH_ENABLED=true
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SPEECH_TIMEOUT_S=60
SPEECH_MAX_CHARS=1500

# Conversation memory (working memory, Redis-backed; fail-open when Redis is down)
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=12
MEMORY_INJECT_TURNS=4
MEMORY_TTL_S=86400
# Injection budget in tokens (x4 chars internally)
MEMORY_TOKEN_BUDGET=3000
# Answers stored in history are truncated to this many characters
MEMORY_MAX_ANSWER_CHARS=1200

# Tracing (opt-in OpenTelemetry). console | otlp
TRACING_ENABLED=false
TRACING_EXPORTER=console
TRACING_OTLP_ENDPOINT=

# Investigations (Phase 4 deep research, DEC-053; budgets are config, not constants)
INVESTIGATION_MAX_ITERATIONS=3
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_MAX_WALL_TIME_S=120
INVESTIGATION_TTL_S=604800

# Investigation tools (P4-1; all integrations off unless configured)
RADAR_BASE_URL=http://localhost:8000
RADAR_INTEGRATION_ENABLED=false
RADAR_API_KEY=
RAG_BASE_URL=
RAG_INTEGRATION_ENABLED=false
RAG_SERVICE_USER=
RAG_SERVICE_PASS=
TOOL_TIMEOUT_S=30
WEB_TOOLS_ENABLED=false
TAVILY_API_KEY=
MAX_WEB_CALLS=4

# Analysis workers (P4-2; empty = first available connector)
ANALYSIS_CONNECTOR_ID=

# Milestone synthesis (P4-3; empty = first available connector)
SYNTHESIS_CONNECTOR_ID=

# Workspace views (P4-4; independent of tool flags)
WORKSPACE_RADAR_ENABLED=false
WORKSPACE_RAG_ENABLED=false