# Copy this file to .env and add only rotated, active provider credentials.
# Never commit .env or real key values.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Override model defaults if providers retire them
# Mistral Medium 3.5; dated snapshot alternative: mistral-medium-2604
MISTRAL_MODEL=mistral-medium-latest
GEMINI_MODEL=gemini-3.7-flash

APP_NAME=ARGUS
APP_VERSION=0.3.0
DEBUG=false

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CONNECTOR_TIMEOUT_S=45
CONNECTOR_MAX_RETRIES=1

ROUTING_CONFIG_PATH=config/routing.yaml
# static = fixed YAML chains; semantic = infer a profile from the query
ROUTER_STRATEGY=static
# Embeddings backend for the semantic router: auto|gemini|openai|none.
# 'auto' prefers Gemini when its key exists. Failures fall back to the
# keyword classifier automatically.
ROUTER_EMBEDDING_PROVIDER=auto
ROUTER_EMBEDDING_MODEL=
# Cosine similarity needed to accept an embedding match (0.0-1.0)
ROUTER_EMBEDDING_THRESHOLD=0.35

CACHE_ENABLED=true
CACHE_TTL_S=3600
CACHE_MAX_BYTES=262144

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
# fixed = INCR buckets per window (allows 2x boundary bursts)
# sliding = exact last-window count (no boundary bursts, slightly more Redis work)
RATE_LIMIT_ALGORITHM=fixed

# Auth (opt-in): enable only with JWT_SECRET set and rotated client creds.
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

REPORT_MAX_REPAIR_ROUNDS=1

# Audio transcription (Sarvam STT). Leave SARVAM_API_KEY empty to disable.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# transcribe|translate|verbatim|translit|codemix
SARVAM_STT_MODE=transcribe
# BCP-47 code or 'unknown' for auto-detect
SARVAM_STT_LANGUAGE=unknown
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_TIMEOUT_S=60
AUDIO_MAX_UPLOAD_BYTES=10485760

# Tracing (opt-in OpenTelemetry). console | otlp
TRACING_ENABLED=false
TRACING_EXPORTER=console
TRACING_OTLP_ENDPOINT=